generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ConversationType {
  DM
  GROUP
}

enum Interval {
  ANNUAL
  MONTHLY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum AdminRole {
  superAdmin
  supportAdmin
}

enum PlanTier {
  FREE
  PRO
  CREATOR
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  EXPIRED
}

enum PrivacyStatus {
  PRIVATE
  PUBLIC
}

model Group {
  id        Int      @id @default(autoincrement())
  ref       String   @unique @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  admin     User?    @relation(fields: [adminId], references: [id])
  adminId   Int?

  userGroups   UserGroup[]
  groupPosts   GroupPost[]
  joinedGroups joinedGroup[]
}

model Post {
  id         Int         @id @default(autoincrement())
  ref        String      @unique @default(uuid())
  title      String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  admin      Admin?      @relation(fields: [adminId], references: [id])
  adminId    Int?
  likes      Like[]
  bookmarks  Bookmark[]
  postImages PostImage[]
  comments   Comment[]
}

model PostImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Comment {
  id        Int      @id @default(autoincrement())
  ref       String   @unique @default(uuid())
  content   String
  postId    Int
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model User {
  id                        Int                  @id @default(autoincrement())
  ref                       String               @unique @default(uuid())
  firstName                 String
  lastName                  String
  email                     String               @unique
  userName                  String               @unique
  password                  String
  createdAt                 DateTime             @default(now())
  avatarSrc                 String?
  updatedAt                 DateTime             @updatedAt
  bio                       String?
  is_verified               Boolean?
  verified_at               DateTime?
  verification_token        String?
  verification_token_expiry DateTime?
  softDelete                DateTime?
  posts                     Post[]
  payments                  Payment[]
  userGroups                UserGroup[]
  joinedGroups              joinedGroup[]
  groups                    Group[]
  groupPosts                GroupPost[]
  likes                     Like[]
  conversations             ConversationMember[]
  sentMessages              Message[]            @relation("SentMessages")
  bookmarks                 Bookmark[]
  subscription              Subscription?
  comments                  Comment[]
  privacy                   Privacy?
}

model UserGroup {
  id      Int    @id @default(autoincrement())
  ref     String @unique @default(uuid())
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int
  groups  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId Int

  @@unique([userId, groupId])
}

model Subscription {
  id                       Int                @id @default(autoincrement())
  ref                      String             @unique @default(uuid())
  userId                   Int                @unique
  plan                     PlanTier           @default(FREE)
  status                   SubscriptionStatus @default(ACTIVE)
  interval                 Interval           @default(MONTHLY)
  paystackSubscriptionCode String? // from Paystack webhook
  paystackCustomerCode     String?
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime? // when does this billing cycle end
  cancelledAt              DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[] // link payments to the subscription
}

model Like {
  id        Int       @id @default(autoincrement())
  ref       String    @unique @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  post      Post      @relation(fields: [post_Id], references: [id], onDelete: Cascade)
  post_Id   Int
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@map("post_likes")
}

model Bookmark {
  id        Int       @id @default(autoincrement())
  ref       String    @unique @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  post      Post      @relation(fields: [post_Id], references: [id], onDelete: Cascade)
  post_Id   Int
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@map("post_bookmark")
}

model GroupPost {
  id        Int      @id @default(autoincrement())
  ref       String   @unique @default(uuid())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   Int
  message   String   @default("")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int?
  createdAt DateTime @default(now())
}

model Payment {
  id        Int           @id @default(autoincrement())
  ref       String        @unique @default(uuid())
  userId    Int
  reference String        @unique
  amount    Float
  email     String
  status    PaymentStatus @default(PENDING)
  channel   String?
  currency  String?
  planId    String?

  interval           Interval      @default(MONTHLY)
  paidAt             DateTime?     @default(now())
  metadata           Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  authorization_code String?
  user               User          @relation(fields: [userId], references: [id])
  subscriptionId     Int?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  plan               String?
}

model joinedGroup {
  id       Int      @id @default(autoincrement())
  ref      String   @unique @default(uuid())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  joinedAt DateTime @default(now())
  groups   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId  Int

  @@unique([userId, groupId])
}

model Admin {
  id        Int       @id @default(autoincrement())
  ref       String    @unique @default(uuid())
  firstName String
  lastName  String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  posts     Post[]
  role      AdminRole @default(supportAdmin)

  mustChangePassword Boolean @default(true)
}

model PasswordToken {
  id        Int      @id @default(autoincrement())
  token     String
  email     String   @unique
  createdAt DateTime @default(now())
  expiredAt DateTime
}

model Conversation {
  id        Int                  @id @default(autoincrement())
  ref       String               @unique @default(uuid())
  type      ConversationType     @default(DM)
  name      String?
  createdAt DateTime             @default(now())
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  id             Int          @id @default(autoincrement())
  ref            String       @unique @default(uuid())
  conversationId Int
  isAdmin        Boolean      @default(false)
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             Int          @id @default(autoincrement())
  ref            String       @unique @default(uuid())
  body           String
  conversationId Int
  senderId       Int
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
}

model Privacy {
  id               Int     @id @default(autoincrement())
  privateAccount   Boolean @default(false)
  showInSearch     Boolean @default(false)
  suggestAccount   Boolean @default(false)
  showOnlineStatus Boolean @default(false)
  showReadReceipts Boolean @default(false)
  ref              String  @unique @default(uuid())
  userId           Int     @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
